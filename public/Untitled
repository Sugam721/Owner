<script>
function initRotatingText() {
  console.log('[rotating-text] build: word-first-2026-06'); // version marker — confirm this logs on the live page
  document.querySelectorAll('[data-rotating-title]').forEach((heading) => {
    const rotatingSpan = heading.querySelector('[data-rotating-words]');
    if (!rotatingSpan) return;
    if (rotatingSpan.__rotatingInit) {
      console.warn(
        '[rotating-text] ABORTED: this span was already built by ANOTHER rotating-text script. ' +
          'The DOM you see is from that older script, not this build. Remove the duplicate.'
      );
      return;
    }
    rotatingSpan.__rotatingInit = true;

    const stepDuration = parseFloat(heading.getAttribute('data-step-duration') || '1.75');
    const wordStagger = parseFloat(heading.getAttribute('data-word-stagger') || '0.08');

    // First phrase = whatever is hardcoded in the span (great for no-JS first paint).
    const hardcoded = rotatingSpan.textContent.trim();

    // Remaining phrases come from the attribute, comma-separated.
    const attrPhrases = (rotatingSpan.getAttribute('data-rotating-words') || '')
      .split(',')
      .map((p) => p.trim())
      .filter(Boolean);

    const phrases = [hardcoded, ...attrPhrases.filter((p) => p !== hardcoded)].filter(Boolean);
    if (!phrases.length) return;

    // inline-grid: every phrase lives in the same cell, so the grid sizes to the widest one
    // automatically (no JS measuring). clip-path masks the vertical word travel.
    const wrapper = document.createElement('span');
    wrapper.className = 'rotating-text__inner';
    wrapper.style.cssText =
      'position:relative;display:inline-grid;vertical-align:baseline;' +
      '-webkit-clip-path:inset(0);clip-path:inset(0);padding-bottom: 0.1em';

    const phraseEls = phrases.map((phrase) => {
      const phraseEl = document.createElement('span');
      phraseEl.className = 'rotating-text__phrase';
      // Same grid cell as every other phrase; stretches to the widest, words centered.
      phraseEl.style.cssText = 'grid-area:1 / 1;white-space:nowrap;text-align:center;';

      const parts = phrase.split(/\s+/).filter(Boolean); // drop empties from stray whitespace
      phraseEl.words = parts.map((word, i) => {
        const wordEl = document.createElement('span');
        wordEl.className = 'rotating-text__word';
        wordEl.style.cssText = 'display:inline-block;will-change:transform;';
        // Bake the gap INTO the word as a trailing NBSP (every word except the last). No
        // separate space text nodes between the inline-block words — those collapse/trim at
        // the boundaries and the last gap gets dropped. A trailing NBSP inside the span can't
        // be collapsed, trimmed, or reordered, so every gap is guaranteed and childNodes[0]
        // is always the first word span (never a text node).
        wordEl.textContent = i < parts.length - 1 ? word + ' ' : word;
        phraseEl.appendChild(wordEl);
        return wordEl;
      });

      wrapper.appendChild(phraseEl);
      return phraseEl;
    });

    const inDuration = 0.75;
    const outDuration = 0.6;

    // Apply the first-frame state on the STILL-DETACHED wrapper: phrase 0 visible, the rest
    // hidden. Then swap it in. Because the state is set before insertion, the new content
    // paints in its final form on the very first frame — no blank/flash gap between the
    // original text and our build (which deferring to requestAnimationFrame caused).
    phraseEls.forEach((p) => gsap.set(p.words, { yPercent: 150, autoAlpha: 0 }));
    gsap.set(phraseEls[0].words, { yPercent: 0, autoAlpha: 1 });

    rotatingSpan.textContent = '';
    rotatingSpan.appendChild(wrapper);

    let activeIndex = 0;

    function showNext() {
      const nextIndex = (activeIndex + 1) % phraseEls.length;
      const prev = phraseEls[activeIndex];
      const current = phraseEls[nextIndex];

      // Old phrase's words all leave together (no stagger).
      gsap.to(prev.words, {
        yPercent: -150,
        autoAlpha: 0,
        duration: outDuration,
        ease: 'power4.inOut',
      });

      // New phrase's words stagger IN.
      gsap.fromTo(
        current.words,
        { yPercent: 150, autoAlpha: 0 },
        {
          yPercent: 0,
          autoAlpha: 1,
          duration: inDuration,
          ease: 'power4.inOut',
          stagger: wordStagger,
        }
      );

      activeIndex = nextIndex;
      gsap.delayedCall(stepDuration, showNext);
    }

    // First rotation fires at half the step so users reliably catch that it rotates;
    // every subsequent one (scheduled inside showNext) uses the full stepDuration.
    if (phraseEls.length > 1) {
      gsap.delayedCall(stepDuration / 2, showNext);
    }
  });
}

// Initialize Rotating Text
document.addEventListener('DOMContentLoaded', function () {
  initRotatingText();
});

</script></body></html>